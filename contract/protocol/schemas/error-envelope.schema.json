{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nmzp.local/contract-candidate/error-envelope.schema.json",
  "title": "ErrorEnvelope",
  "description": "WP-21 candidate for PROTOCOL §6.1. Not frozen. error.code is the ErrorCode enum shared with openapi.yaml. message is for humans. Programs use code and data only. data is required for policy_conflict and cas_conflict only, with the fields in WP-21_D8_D9_D14_DECISIONS-r1. Every other code forbids data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "outcome", "requestId"],
      "properties": {
        "code": {
          "enum": ["payload_too_large", "bad_json", "bad_schema", "unauthorized", "event_conflict", "event_expired", "evaluation_immutable", "bad_receipt", "bad_backfill", "bad_heartbeat", "storage_not_enabled", "processing_stopped", "policy_conflict", "cas_conflict", "policy_recovery_required", "policy_not_committed", "policy_queue_full", "audit_storage_unavailable", "probe_proof_required", "internal_error", "input_truncated", "invalid_utf8", "lone_surrogate", "duplicate_member", "depth_exceeded", "extras_exceeded", "pointer_too_long", "event_id_invalid"],
          "description": "Same members and order as openapi.yaml ErrorCode. The PROTOCOL example word conflict is not its own member; v1 emits event_conflict and cas_conflict. Not a claim that every v1 {ok:false,error} string already uses this envelope."
        },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "outcome": { "enum": ["not_committed", "unknown", "rejected"] },
        "data": {
          "description": "Present only when code is policy_conflict or cas_conflict. allOf closes those shapes and forbids data for every other code."
        },
        "requestId": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "error": {
            "properties": { "code": { "const": "policy_conflict" } },
            "required": ["code"]
          }
        },
        "required": ["error"]
      },
      "then": {
        "properties": {
          "error": {
            "required": ["data"],
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": ["currentVersion", "currentRulesHash"],
                "properties": {
                  "currentVersion": { "type": "integer", "minimum": 0 },
                  "currentRulesHash": { "$ref": "defs.schema.json#/$defs/sha256Prefixed" }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error": {
            "properties": { "code": { "const": "cas_conflict" } },
            "required": ["code"]
          }
        },
        "required": ["error"]
      },
      "then": {
        "properties": {
          "error": {
            "required": ["data"],
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": ["currentVersion"],
                "properties": {
                  "currentVersion": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error": {
            "properties": {
              "code": { "not": { "enum": ["policy_conflict", "cas_conflict"] } }
            },
            "required": ["code"]
          }
        },
        "required": ["error"]
      },
      "then": {
        "properties": {
          "error": {
            "not": { "required": ["data"] }
          }
        }
      }
    }
  ]
}
