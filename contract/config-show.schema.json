{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nmzp.local/contract/config-show.schema.json",
  "title": "ConfigShowReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value", "source", "secret", "securityRelevant", "valid", "isSet"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "number", "null"] },
        "source": { "enum": ["DEFAULT", "ENV", "FILE"] },
        "secret": { "type": "boolean" },
        "securityRelevant": { "type": "boolean" },
        "valid": { "type": "boolean" },
        "isSet": { "type": "boolean" },
        "problem": { "type": "string", "minLength": 1 }
      }
    }
  }
}
